(
    tasks: [
        (id: "stamp", type: "cu_action_governor::testkit::StampSrc",),
        (id: "fb", type: "cu_action_governor::testkit::FeedbackSrc",),
        (id: "chunk", type: "cu_action_governor::testkit::ChunkSrc", config: {"chunk_every": 1},),
        (id: "gov", type: "cu_action_governor::ActionGovernor", config: {"min_0": -1.0, "max_0": 1.0, "min_1": -1.0, "max_1": 1.0, "min_2": -1.0, "max_2": 1.0, "min_3": -1.0, "max_3": 1.0, "min_4": -1.0, "max_4": 1.0, "min_5": -1.0, "max_5": 1.0, "max_step": 0.02, "max_lead": 0.3, "max_age_ms": 150.0, "hold_deadline_ms": 300.0, "cycle_ms": 10.0},),
        (id: "sink", type: "cu_action_governor::testkit::GoalSink",),
    ],
    cnx: [
        (src: "chunk", dst: "gov", msg: "cu_action_governor::ActionChunk"),
        (src: "fb", dst: "gov", msg: "cu_action_governor::governor::JointPositions"),
        (src: "stamp", dst: "gov", msg: "cu_action_governor::ObsStamp"),
        (src: "gov", dst: "sink", msg: "cu_action_governor::governor::JointPositions"),
    ],
    logging: (slab_size_mib: 64, section_size_mib: 16, keyframe_interval: 8),
)
