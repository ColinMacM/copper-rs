(
    tasks: [
        (id: "stamp", type: "cu_action_governor::testkit::StampSrc",),
        (id: "fb", type: "cu_action_governor::testkit::FeedbackSrc",),
        (id: "chunk", type: "cu_action_governor::testkit::ChunkSrc", config: {"chunk_every": 1},),
        (id: "sink", type: "cu_action_governor::testkit::GoalSink",),
    ],
    cnx: [
        (src: "chunk", dst: "__nc__", msg: "cu_action_governor::ActionChunk"),
        (src: "stamp", dst: "__nc__", msg: "cu_action_governor::ObsStamp"),
        (src: "fb", dst: "sink", msg: "cu_action_governor::governor::JointPositions"),
    ],
    logging: (slab_size_mib: 64, section_size_mib: 16, keyframe_interval: 8),
)
