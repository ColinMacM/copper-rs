(
    missions: [(id: "record"), (id: "policy")],
    tasks: [
        (id: "leader", type: "cu_policy::testkit::FeedbackSrc", missions: ["record"]),
        (id: "fb", type: "cu_policy::testkit::FeedbackSrc"),
        (id: "stamp", type: "cu_policy::testkit::StampSrc", missions: ["policy"]),
        (id: "chunk", type: "cu_policy::testkit::ChunkSrc", missions: ["policy"]),
        (id: "gov", type: "cu_policy::ActionGovernor", config: {"min_0": -1.0, "max_0": 1.0, "min_1": -1.0, "max_1": 1.0, "min_2": -1.0, "max_2": 1.0, "min_3": -1.0, "max_3": 1.0, "min_4": -1.0, "max_4": 1.0, "min_5": -1.0, "max_5": 1.0, "max_step": 0.02, "max_lead": 0.3, "max_age_ms": 150.0, "hold_deadline_ms": 300.0, "cycle_ms": 10.0}, missions: ["policy"]),
        (id: "sink", type: "cu_policy::testkit::GoalSink"),
    ],
    cnx: [
        (src: "leader", dst: "sink", msg: "cu_policy::governor::JointPositions", missions: ["record"]),
        (src: "fb", dst: "__nc__", msg: "cu_policy::governor::JointPositions", missions: ["record"]),
        (src: "fb", dst: "gov", msg: "cu_policy::governor::JointPositions", missions: ["policy"]),
        (src: "stamp", dst: "gov", msg: "cu_policy::ObsStamp", missions: ["policy"]),
        (src: "chunk", dst: "gov", msg: "cu_policy::ActionChunk", missions: ["policy"]),
        (src: "gov", dst: "sink", msg: "cu_policy::governor::JointPositions", missions: ["policy"]),
        (src: "gov", dst: "__nc__", msg: "cu_policy::ExecState", missions: ["policy"]),
        (src: "gov", dst: "__nc__", msg: "cu_policy::InferenceRequest", missions: ["policy"]),
    ],
    logging: (slab_size_mib: 64, section_size_mib: 16, keyframe_interval: 8),
)
