(
    format: 1,
    id: "cu-policy-loop",
    version: "1.3.0-dev",
    description: "Policy loop: the action governor with its chunk scheduler, and the Zenoh link to the policy process",
    copper: ">=1.3.0-dev",
    rust: [(package: "cu-policy", version: ">=1.3.0-dev")],
    params: {
        "min_0": (kind: Float),
        "max_0": (kind: Float),
        "min_1": (kind: Float),
        "max_1": (kind: Float),
        "min_2": (kind: Float),
        "max_2": (kind: Float),
        "min_3": (kind: Float),
        "max_3": (kind: Float),
        "min_4": (kind: Float),
        "max_4": (kind: Float),
        "min_5": (kind: Float),
        "max_5": (kind: Float),
        "max_step": (kind: Float, min: 0.0),
        "max_lead": (kind: Float, min: 0.0),
        "cycle_ms": (kind: Float, min: 0.1),
        "max_age_ms": (kind: Float, min: 1.0, default: 600.0),
        "hold_deadline_ms": (kind: Float, min: 1.0, default: 2500.0),
        "horizon": (kind: Int, min: 2, max: 50, default: 50),
        "s_min": (kind: Int, min: 0, max: 49, default: 25),
        "d_init": (kind: Int, min: 0, max: 49, default: 3),
        "blend_steps": (kind: Int, min: 0, max: 16, default: 3),
    },
    fragments: {
        "loop": (path: "fragments/loop.ron", public: ["gov", "link"]),
    },
    assets: [
        "python/copper_policy/__init__.py",
        "python/copper_policy/__main__.py",
        "python/copper_policy/calibration.py",
        "python/copper_policy/flow_policy.py",
        "python/copper_policy/policies.py",
        "python/copper_policy/rtc.py",
        "python/copper_policy/rtc_sim.py",
        "python/copper_policy/runner.py",
        "python/copper_policy/server.py",
        "python/copper_policy/wire.py",
        "tests/golden/vectors.json",
    ],
)
