(
    tasks: [
        (id: "camera", type: "tasks::SyntheticCamera"),
        (id: "obs", type: "tasks::ObsBuilder"),
        (id: "status_probe", type: "tasks::StatusProbe"),
        (id: "chunk_probe", type: "tasks::ChunkProbe"),
    ],
    bridges: [
        (
            id: "arm",
            type: "bridges::MockArm",
            config: {"start": 2048.0, "slew": 40.0},
            channels: [Rx(id: "positions"), Tx(id: "goals")],
        ),
    ],
    cnx: [
        (src: "arm/positions", dst: "obs", msg: "cu_policy::JointPositions"),
        (src: "obs", dst: "vla_link/obs", msg: "cu_policy::ObsPacket"),
        (src: "arm/positions", dst: "vla_gov", msg: "cu_policy::JointPositions"),
        (src: "obs", dst: "vla_gov", msg: "cu_policy::ObsStamp"),
        (src: "vla_link/action", dst: "chunk_probe", msg: "cu_policy::ActionChunk"),
        (src: "camera", dst: "vla_link/img", msg: "cu_sensor_payloads::CuImage<Vec<u8>>"),
        (src: "vla_link/status", dst: "status_probe", msg: "cu_policy::link::LinkStatus"),
        (src: "vla_gov", dst: "arm/goals", msg: "cu_policy::JointPositions"),
    ],
    plugins: [
        (
            path: "../../components/tasks/cu_policy",
            fragment: "loop",
            instance: "vla",
            params: {
                "min_0": 200.0, "max_0": 3900.0,
                "min_1": 200.0, "max_1": 3900.0,
                "min_2": 200.0, "max_2": 3900.0,
                "min_3": 200.0, "max_3": 3900.0,
                "min_4": 200.0, "max_4": 3900.0,
                "min_5": 200.0, "max_5": 3900.0,
                "max_step": 30.0,
                "max_lead": 300.0,
                "cycle_ms": 33.333,
                "hold_deadline_ms": 500.0,
                "s_min": 0,
                "blend_steps": 0,
            },
            pin: "blake3:1e17fc7ce167c6c2aba9c8b22a5c18cf484ea3a087d2de92b893c063219a798d",
        ),
    ],
    logging: (slab_size_mib: 64, section_size_mib: 16, keyframe_interval: 30),
)
